# Use Node 22 Alpine
FROM node:22-alpine

WORKDIR /usr/src/app

# Install global dev tools
RUN npm install -g @nestjs/cli ts-node-dev

# Copy package files first for caching
COPY package*.json ./

# Install dependencies including dev
RUN npm install

# Copy all code
COPY . .

# Expose dev port
EXPOSE 3002

# Run NestJS in dev mode with watch
CMD ["npm", "run", "start:dev"]
