# Application
PORT=3002
BASE_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DB_NAME=buy_me_pencils
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

# Auth
JWT_SECRET=change-this-to-a-secure-secret-min-16-chars
ADMIN_SETUP_TOKEN=your-one-time-admin-setup-token

# Encryption (min 32 chars) - used for payment wallet keys
ENCRYPTION_SECRET=your-32-char-minimum-secret-key-here

# --- Withdrawals & TRON (USDT TRC20) ---
TRON_FULL_HOST=https://api.trongrid.io
# Optional: for higher TronGrid rate limits
# TRONGRID_API_KEY=your-trongrid-api-key

# Master wallet: receives swept USDT and pays out withdrawals (never log private key)
TRON_MASTER_ADDRESS=your-master-tron-base58-address
TRON_MASTER_PRIVATE_KEY=your-master-wallet-private-key

# USDT TRC20 contract (default mainnet if omitted)
# TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Minimum withdrawal amount in USDT (default: 1)
# MIN_WITHDRAWAL_AMOUNT=1

# Redis (for BullMQ withdrawal queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# Mail (e.g. Unosend)
# UNOSEND_API_KEY=un_xxxxxxxxxx
# MAIL_FROM=hello@example.com

# Payments (ZarinPal)
# ZARINPAL_MERCHANT_ID=...
# ZARINPAL_URL=https://sandbox.zarinpal.com
